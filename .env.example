# Database (Neon / Supabase / local Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth — use a long random string in production
JWT_SECRET="replace-with-a-long-random-secret"

# Optional: public app URL (OpenRouter referer)
APP_URL="http://localhost:3000"

# Optional: CryptoPanic news API (falls back to bundled JSON if unset)
CRYPTOPANIC_API_KEY=""

# Optional: OpenRouter LLM (falls back to mock playbook if unset)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"

# Optional: Hugging Face Inference API (used if OpenRouter is unset)
HUGGINGFACE_API_KEY=""
